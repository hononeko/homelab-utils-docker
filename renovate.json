{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hononeko/renovate-config",
    "github>hononeko/renovate-config:hononeko-actions"
  ],
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },

    {
      "matchUpdateTypes": [
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["!hononeko/actions", "!hononeko/actions/**"],
      "pinDigests": true,
      "groupName": "github-actions",
      "schedule": ["every weekend"],
      "description": "Group all GitHub Actions updates and schedule them weekly"
    }
  ]
}
